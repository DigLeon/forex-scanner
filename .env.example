# Twelve Data REST API key (required for market data)
TWELVE_DATA_API_KEY=

# Optional visual chart review
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
OPENAI_VISION_TIMEOUT_MS=45000

# Enable only when your selected provider/plan supports WebSocket access
ENABLE_TWELVE_WS=false

# REST cache/refresh cadence. These reduce duplicate requests but do not
# guarantee that a provider's daily credit quota will not be exhausted.
TWELVE_REST_CACHE_MS=60000
TWELVE_REST_REFRESH_MS=60000

# Telegram alerts
TELEGRAM_ALERTS=true
TELEGRAM_BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE
TELEGRAM_CHAT_IDS=PUT_CHAT_ID_1_HERE,PUT_CHAT_ID_2_HERE,PUT_CHAT_ID_3_HERE

# v5.0 Signal Lifecycle: maximum time READY remains under fast watch while strict priority confirmation is retried.
FAST_RECHECK_READY_TIMEOUT_MS=180000

# Early GET READY may trigger this many score points below strict pair threshold.
# Final TRADE threshold is NOT reduced.
GET_READY_SCORE_TOLERANCE=2
